<?xml version="1.0" encoding="utf-8"?>
<!-- Medalhão de lousa: as ilustrações coloridas saltam sobre o papel claro. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/lousa" />
            <stroke
                android:width="3dp"
                android:color="@color/tinta" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="@color/giz"
                android:dashGap="3dp"
                android:dashWidth="4dp" />
        </shape>
    </item>
</layer-list>
