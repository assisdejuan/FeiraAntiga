<?xml version="1.0" encoding="utf-8"?>
<!-- Categoria como carimbo: borda tracejada em tinta azul escolar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/azul_translucido" />
    <stroke
        android:width="1.5dp"
        android:color="@color/azul_carimbo"
        android:dashGap="3dp"
        android:dashWidth="5dp" />
    <corners android:radius="4dp" />
</shape>
