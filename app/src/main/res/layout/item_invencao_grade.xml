<?xml version="1.0" encoding="utf-8"?>
<!-- Item em grade: mini cartaz vertical. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardInvencaoGrade"
    style="@style/OficinaImpossivel.Cartao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/margem_media"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/imgInvencao"
        android:layout_width="@dimen/imagem_item_grade"
        android:layout_height="@dimen/imagem_item_grade"
        android:background="@drawable/bg_moldura_imagem"
        android:contentDescription="@string/cd_imagem_invencao_generica"
        android:padding="14dp"
        android:scaleType="fitCenter"
        tools:src="@drawable/img_foguete" />

    <TextView
        android:id="@+id/tvNomeInvencao"
        style="@style/OficinaImpossivel.TituloCartaz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:lines="2"
        android:textSize="15sp"
        tools:text="Foguete de Garrafa PET" />

    <TextView
        android:id="@+id/tvCategoriaInvencao"
        style="@style/OficinaImpossivel.ChipCategoria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        tools:text="Física" />
</LinearLayout>
