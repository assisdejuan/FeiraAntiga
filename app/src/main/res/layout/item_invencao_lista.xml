<?xml version="1.0" encoding="utf-8"?>
<!-- Item em lista: "ingresso" de papel com medalhão, nome em serifa e carimbo da categoria. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardInvencaoLista"
    style="@style/OficinaImpossivel.Cartao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/margem_media"
    android:paddingTop="@dimen/margem_media"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/imgInvencao"
        android:layout_width="@dimen/imagem_item_lista"
        android:layout_height="@dimen/imagem_item_lista"
        android:background="@drawable/bg_moldura_imagem"
        android:contentDescription="@string/cd_imagem_invencao_generica"
        android:padding="11dp"
        android:scaleType="fitCenter"
        tools:src="@drawable/img_robo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNomeInvencao"
            style="@style/OficinaImpossivel.TituloCartaz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="17sp"
            tools:text="Robô Seguidor de Linha" />

        <TextView
            android:id="@+id/tvCategoriaInvencao"
            style="@style/OficinaImpossivel.ChipCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:text="Robótica" />
    </LinearLayout>
</LinearLayout>
