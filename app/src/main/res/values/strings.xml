    <!-- Invenções iniciais -->
    <string name="invencao_caldeirao_nome">Caldeirão Autoborbulhante</string>
    <string name="invencao_caldeirao_inventor">Bruxa Morgana Fuligem</string>
    <string name="invencao_caldeirao_descricao">Caldeirão que mexe a própria poção em espiral perfeita e solta um arroto esverdeado quando o feitiço chega ao ponto. Acompanha tampa anti-sapos fujões.</string>

    <string name="invencao_abobora_nome">Abóbora Lanterna Falante</string>
    <string name="invencao_abobora_inventor">Jack O\'Lanterna</string>
    <string name="invencao_abobora_descricao">Lanterna de abóbora com engrenagens de cobre que ilumina trilhas escuras e conta piadas arrepiantes a cada badalada da meia-noite.</string>

    <string name="invencao_vassoura_nome">Vassoura a Jato Turbo</string>
    <string name="invencao_vassoura_inventor">Hilda Rabiscava</string>
    <string name="invencao_vassoura_descricao">Vassoura com propulsores de poeira estelar, freio de cauda de gato e piloto automático para voos rasantes sobre o cemitério.</string>

    <string name="invencao_detector_nome">Detector de Fantasmas Portátil</string>
    <string name="invencao_detector_inventor">Dr. Ectoplasma</string>
    <string name="invencao_detector_descricao">Aparelho que vibra, assobia e brilha em lilás quando um fantasma tímido se aproxima. Calibrado para assombrações de até três séculos.</string>

    <string name="invencao_morcego_nome">Morcego-Drone Vigia</string>
    <string name="invencao_morcego_inventor">Conde Vladislau Jr.</string>
    <string name="invencao_morcego_descricao">Drone em forma de morcego com hélice silenciosa e ecolocalização aprimorada, ideal para patrulhar torres de castelos em noites sem lua.</string>

    <string name="invencao_relogio_nome">Relógio da Lua Cheia</string>
    <string name="invencao_relogio_inventor">Lupércio Uivante</string>
    <string name="invencao_relogio_descricao">Relógio de bolso que conta as horas até a próxima lua cheia e uiva baixinho como alarme para lobisomens distraídos.</string>

