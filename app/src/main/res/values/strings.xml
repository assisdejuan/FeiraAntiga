    <!-- Projetos iniciais -->
    <string name="invencao_vulcao_nome">Vulcão de Bicarbonato Turbo</string>
    <string name="invencao_vulcao_inventor">Ana Lavoisier</string>
    <string name="invencao_vulcao_descricao">Maquete de vulcão que mostra a reação entre bicarbonato de sódio e vinagre. Um funil interno direciona o gás carbônico e faz a espuma subir três vezes mais alto que a versão clássica.</string>

    <string name="invencao_robo_nome">Robô Seguidor de Linha</string>
    <string name="invencao_robo_inventor">Caio Turing</string>
    <string name="invencao_robo_descricao">Robô com dois sensores infravermelhos que lê uma faixa preta no chão e corrige a direção sozinho. Feito com motores de carrinho reaproveitados e uma placa programável.</string>

    <string name="invencao_foguete_nome">Foguete de Garrafa PET</string>
    <string name="invencao_foguete_inventor">Bia Gagarin</string>
    <string name="invencao_foguete_descricao">Foguete movido a água e ar comprimido que demonstra a terceira lei de Newton. As aletas de papelão estabilizam o voo, que já passou de 40 metros nos testes do pátio.</string>

    <string name="invencao_solar_nome">Carregador Solar de Bolso</string>
    <string name="invencao_solar_inventor">Davi Volta</string>
    <string name="invencao_solar_descricao">Pequeno painel fotovoltaico ligado a uma bateria recarregável que carrega um celular em cerca de quatro horas de sol. A caixa é impressa em 3D com plástico reciclado.</string>

    <string name="invencao_hidroponia_nome">Horta Hidropônica Inteligente</string>
    <string name="invencao_hidroponia_inventor">Lia Mendel</string>
    <string name="invencao_hidroponia_descricao">Cultivo de alface sem terra, com raízes mergulhadas em solução nutritiva. Um sensor de umidade avisa por LED quando é hora de completar a água do reservatório.</string>

    <string name="invencao_telescopio_nome">Telescópio de Papelão</string>
    <string name="invencao_telescopio_inventor">Rafa Hubble</string>
    <string name="invencao_telescopio_descricao">Telescópio refrator montado com tubos de papelão e duas lentes de óculos. Aumenta cerca de 20 vezes, o suficiente para ver as crateras da Lua e as luas de Júpiter.</string>

